# /etc/valtexa/rover.env — sem segredo (a chave do robô mora em identity.json, 0600).
VALTEXA_URL=https://api.valtexa.example
# Módulo do integrador que monta a HAL real (câmeras, GNSS, IMU, controlador...).
# Para demonstração/homologação SEM hardware: valtexa_rover.sim:hal_de_demonstracao (SIMULADO).
VALTEXA_HAL=adapters_do_robo:hardware
